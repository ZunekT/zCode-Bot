# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Baza i cache
DATABASE_URL=postgresql://zxcode:zxcode@localhost:5432/zxcode
REDIS_URL=redis://localhost:6379

# GitHub (changelog z release, /bug -> issue)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Serwer HTTP (webhooki GitHuba, heartbeat monitoringu)
HTTP_PORT=3000
# Publiczny adres serwera HTTP (do linków heartbeat), np. https://bot.zxcode.pl
# PUBLIC_URL=
# Monitoring „presence” (status online bota) – najpierw włącz Presence Intent w Developer Portal
ENABLE_PRESENCE_INTENT=false

# Panel WWW (zxcode.pl) – wewnętrzne API, tylko w sieci Dockera. Sekret: openssl rand -hex 32
# INTERNAL_API_SECRET=
# INTERNAL_PORT=3100
# Twoje ID Discord – kto edytuje ustawienia bota zxCode w panelu (domyślnie właściciel serwera)
# OWNER_ID=

# Strona zxcode.pl (usługa „web” w docker-compose). Najprościej: bash docker/setup-panel.sh
# SITE_URL=https://zxcode.pl
# Discord Developer Portal → OAuth2 → Client Secret; Redirects: https://zxcode.pl/api/auth/callback
# DISCORD_CLIENT_SECRET=
# SESSION_SECRET=
# Przycisk „Zamów bota” (zaproszenie na serwer zxCode)
# DISCORD_INVITE_URL=

# debug | info | warn | error
LOG_LEVEL=info
