# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Baza i cache
DATABASE_URL=postgresql://zxcode:zxcode@localhost:5432/zxcode
REDIS_URL=redis://localhost:6379

# GitHub (changelog z release, /bug -> issue)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Serwer HTTP (webhooki GitHuba, heartbeat monitoringu)
HTTP_PORT=3000
# Publiczny adres serwera HTTP (do linków heartbeat), np. https://bot.zxcode.pl
# PUBLIC_URL=
# Monitoring „presence” (status online bota) – najpierw włącz Presence Intent w Developer Portal
ENABLE_PRESENCE_INTENT=false

# debug | info | warn | error
LOG_LEVEL=info
