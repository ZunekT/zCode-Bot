{
  "name": "zxcode-sdk",
  "version": "1.0.0",
  "description": "zxCode SDK – ustawienia bota Discord edytowane w panelu zxcode.pl, uprawnienia komend, profil i monitoring.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    }
  },
  "files": ["index.js", "index.mjs", "index.d.ts", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "keywords": ["discord", "discord.js", "bot", "dashboard", "config", "panel", "zxcode"],
  "license": "UNLICENSED",
  "peerDependencies": {
    "discord.js": ">=14"
  },
  "peerDependenciesMeta": {
    "discord.js": { "optional": true }
  }
}
