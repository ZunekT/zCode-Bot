generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model GuildConfig {
  guildId String @id

  ticketCategoryId     String?
  archiveCategoryId    String?
  transcriptChannelId  String?
  ticketAutoCloseHours Int     @default(48)
  ticketSlaHours       Int     @default(12)

  logChannelId          String?
  auditChannelId        String?
  announcementChannelId String?
  changelogChannelId    String?
  reviewChannelId       String?
  staffAlertChannelId   String?

  staffRoleId       String?
  adminRoleId       String?
  clientRoleId      String?
  loyalClientRoleId String?
  verifiedRoleId    String?

  logChannels        Json     @default("{}")
  logIgnoredChannels String[] @default([])

  unverifiedRoleId              String?
  verificationMode              String  @default("captcha")
  verificationMinAccountAgeDays Int     @default(0)
  verificationLockdown          Boolean @default(false)
  antiRaidEnabled               Boolean @default(true)
  antiRaidJoins                 Int     @default(10)
  antiRaidSeconds               Int     @default(30)

  modules Json @default("{}")

  statusBoardChannelId String?
  statusBoardMessageId String?

  maintenance        Boolean @default(false)
  maintenanceMessage String?

  paymentDetails String?

  modLogChannelId    String?
  modDmUsers         Boolean @default(true)
  modAppealText      String?
  modRequireReason   Boolean @default(false)
  warnExpireDays     Int     @default(30)
  warnTimeoutAt      Int     @default(3)
  warnTimeoutMinutes Int     @default(60)
  warnKickAt         Int     @default(0)
  warnBanAt          Int     @default(0)

  giveawayManagerRoleId String?
  giveawayPingRoleId    String?
  pollsForEveryone      Boolean @default(false)

  updatedAt DateTime @updatedAt
}

enum ServiceKind {
  BOT
  WEBSITE
}

enum TicketCategory {
  ORDER
  WEBSITE
  SUPPORT
  PARTNERSHIP
  QUESTION
  COMPLAINT
}

enum TicketStatus {
  OPEN
  CLAIMED
  WAITING_CLIENT
  CLOSED
  ARCHIVED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Ticket {
  id               Int            @id @default(autoincrement())
  channelId        String?        @unique
  controlMessageId String?
  userId           String
  category         TicketCategory
  status           TicketStatus   @default(OPEN)
  priority         TicketPriority @default(NORMAL)
  subject          String?
  formData         Json?

  claimedBy String?
  orderId   Int?    @unique
  order     Order?  @relation(fields: [orderId], references: [id])

  openedAt          DateTime  @default(now())
  lastActivityAt    DateTime  @default(now())
  lastClientMsgAt   DateTime?
  lastStaffMsgAt    DateTime?
  firstStaffReplyAt DateTime?
  slaAlertedAt      DateTime?
  closeWarnedAt     DateTime?
  closedAt          DateTime?
  closedBy          String?
  closeReason       String?
  transcriptUrl     String?

  rating        Int?
  ratingComment String?

  participants String[]
  notes        TicketNote[]

  @@index([userId])
  @@index([status])
}

model TicketNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  createdAt DateTime @default(now())
}

model ResponseTemplate {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  title     String
  content   String
  createdBy String
  createdAt DateTime @default(now())
}

model FaqArticle {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  keywords  String[]
  createdAt DateTime @default(now())
}

enum OrderStatus {
  QUOTE
  ACCEPTED
  AWAITING_PAYMENT
  IN_PROGRESS
  TESTING
  DELIVERED
  COMPLETED
  CANCELLED
}

model Order {
  id             Int         @id @default(autoincrement())
  userId         String
  kind           ServiceKind @default(BOT)
  title          String
  description    String?
  status         OrderStatus @default(QUOTE)
  price          Decimal?    @db.Decimal(10, 2)
  currency       String      @default("PLN")
  deadline       DateTime?
  repoUrl        String?
  discountCode   String?
  discountAmount Decimal?    @db.Decimal(10, 2)
  panelChannelId String?
  panelMessageId String?

  ticket        Ticket?
  tasks         OrderTask[]
  payments      Payment[]
  invoices      Invoice[]
  review        Review?
  statusHistory OrderStatusChange[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId])
  @@index([status])
}

model OrderStatusChange {
  id        Int          @id @default(autoincrement())
  orderId   Int
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from      OrderStatus?
  to        OrderStatus
  changedBy String
  createdAt DateTime     @default(now())
}

model OrderTask {
  id       Int     @id @default(autoincrement())
  orderId  Int
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  content  String
  done     Boolean @default(false)
  position Int     @default(0)
}

model Payment {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(10, 2)
  currency   String   @default("PLN")
  note       String?
  recordedBy String
  paidAt     DateTime @default(now())
}

enum InvoiceStatus {
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id         Int           @id @default(autoincrement())
  number     String        @unique
  orderId    Int
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Decimal       @db.Decimal(10, 2)
  currency   String        @default("PLN")
  status     InvoiceStatus @default(ISSUED)
  dueDate    DateTime
  remindedAt DateTime?
  issuedAt   DateTime      @default(now())
}

model PricingPackage {
  id          Int         @id @default(autoincrement())
  kind        ServiceKind @default(BOT)
  name        String      @unique
  description String
  price       Decimal     @db.Decimal(10, 2)
  features    String[]
  position    Int         @default(0)
}

model PricingItem {
  id          Int         @id @default(autoincrement())
  kind        ServiceKind @default(BOT)
  key         String      @unique
  label       String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  emoji       String?
  active      Boolean     @default(true)
}

model DiscountCode {
  code      String    @id
  percent   Int?
  amount    Decimal?  @db.Decimal(10, 2)
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model ClientProfile {
  userId    String   @id
  badges    String[]
  note      String?
  createdAt DateTime @default(now())
}

model PortfolioItem {
  id           Int              @id @default(autoincrement())
  kind         ServiceKind      @default(BOT)
  title        String
  description  String
  technologies String[]
  url          String?
  position     Int              @default(0)
  createdAt    DateTime         @default(now())
  images       PortfolioImage[]
}

model PortfolioImage {
  id          Int           @id @default(autoincrement())
  itemId      Int
  item        PortfolioItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name        String
  contentType String
  data        Bytes
  position    Int           @default(0)
}

model Review {
  id         Int       @id @default(autoincrement())
  orderId    Int?      @unique
  order      Order?    @relation(fields: [orderId], references: [id])
  userId     String
  rating     Int
  content    String
  approved   Boolean   @default(false)
  reviewedAt DateTime?
  reviewedBy String?
  messageId  String?
  createdAt  DateTime  @default(now())

  @@index([approved])
}

model MonitoredBot {
  id                  Int       @id @default(autoincrement())
  name                String    @unique
  ownerId             String?
  healthUrl           String?
  botUserId           String?
  mode                String    @default("http")
  heartbeatToken      String?   @unique
  lastHeartbeatAt     DateTime?
  online              Boolean   @default(true)
  consecutiveFailures Int       @default(0)
  lastResponseMs      Int?
  lastError           String?
  checksTotal         Int       @default(0)
  checksOk            Int       @default(0)
  lastCheckAt         DateTime?
  lastDownAt          DateTime?
  lastUpAt            DateTime?
  version             String?
  orderId             Int?
  sslExpiresAt        DateTime?
  sslWarnedAt         DateTime?
  createdAt           DateTime  @default(now())
}

model DailyStat {
  date     String @id
  members  Int    @default(0)
  joins    Int    @default(0)
  leaves   Int    @default(0)
  messages Int    @default(0)
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model Announcement {
  id          Int           @id @default(autoincrement())
  title       String
  content     String
  imageUrl    String?
  imageData   Bytes?
  imageName   String?
  imageType   String?
  buttons     Json?
  ping        String?
  status      PublishStatus @default(DRAFT)
  publishAt   DateTime?
  channelId   String?
  messageId   String?
  authorId    String
  createdAt   DateTime      @default(now())
  publishedAt DateTime?
}

enum ChangelogSource {
  MANUAL
  GITHUB
}

model ChangelogEntry {
  id          Int             @id @default(autoincrement())
  project     String
  version     String
  sections    Json
  description String?
  releaseUrl  String?
  status      PublishStatus   @default(DRAFT)
  source      ChangelogSource @default(MANUAL)
  messageId   String?
  channelId   String?
  authorId    String?
  createdAt   DateTime        @default(now())
  publishedAt DateTime?

  @@unique([project, version])
}

model ChangelogProject {
  name        String   @id
  description String?
  repo        String?  @unique
  roleId      String?
  channelId   String?
  createdAt   DateTime @default(now())
}

model ChangelogSubscription {
  userId  String
  project String

  @@id([userId, project])
}

enum RoadmapStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

model RoadmapItem {
  id        Int           @id @default(autoincrement())
  project   String
  title     String
  status    RoadmapStatus @default(PLANNED)
  createdAt DateTime      @default(now())
}

model Partnership {
  id          Int      @id @default(autoincrement())
  applicantId String
  serverName  String
  inviteUrl   String
  description String
  members     Int?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

model Reminder {
  id        Int      @id @default(autoincrement())
  userId    String
  content   String
  remindAt  DateTime
  orderId   Int?
  channelId String?
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([remindAt, sent])
}

enum VerificationResult {
  PASSED
  MANUAL
  FAILED
  BLOCKED_AGE
  BLOCKED_LOCKDOWN
}

model VerificationEvent {
  id        Int                @id @default(autoincrement())
  userId    String
  result    VerificationResult
  createdAt DateTime           @default(now())

  @@index([createdAt])
  @@index([userId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  actorId   String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([actorId])
}

model SdkBot {
  id              Int       @id @default(autoincrement())
  name            String
  ownerId         String
  keyHash         String    @unique
  keyPrefix       String
  appId           String?
  username        String?
  avatarUrl       String?
  sdkVersion      String?
  botVersion      String?
  schema          Json?
  commands        Json?
  profile         Json?
  profileRevision Int       @default(0)
  connected       Boolean   @default(false)
  lastSeenAt      DateTime?
  monitoredBotId  Int?      @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  guilds  SdkGuild[]
  configs SdkConfig[]
  members SdkBotMember[]

  @@index([ownerId])
}

model SdkBotMember {
  botId       Int
  userId      String
  permissions String[]
  modules     String[] @default([])
  guilds      String[] @default([])
  addedBy     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bot SdkBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, userId])
  @@index([userId])
}

model SdkGuild {
  botId     Int
  bot       SdkBot   @relation(fields: [botId], references: [id], onDelete: Cascade)
  guildId   String
  name      String
  icon      String?
  channels  Json
  roles     Json
  updatedAt DateTime @updatedAt

  @@id([botId, guildId])
}

model SdkConfig {
  botId       Int
  bot         SdkBot   @relation(fields: [botId], references: [id], onDelete: Cascade)
  guildId     String
  values      Json     @default("{}")
  permissions Json     @default("{}")
  revision    Int      @default(1)
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@id([botId, guildId])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

enum LeadStatus {
  NEW
  CONTACTED
  WON
  CLOSED
}

model Lead {
  id          Int         @id @default(autoincrement())
  kind        ServiceKind @default(WEBSITE)
  name        String
  email       String
  company     String?
  siteType    String
  budget      String
  deadline    String
  description String
  website     String?
  discord     String?
  status      LeadStatus  @default(NEW)
  note        String?
  ipHash      String
  messageId   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum ModAction {
  WARN
  NOTE
  TIMEOUT
  UNTIMEOUT
  KICK
  SOFTBAN
  BAN
  UNBAN
}

model ModCase {
  id           Int       @id @default(autoincrement())
  action       ModAction
  userId       String
  userTag      String?
  moderatorId  String
  reason       String?
  durationMs   BigInt?
  expiresAt    DateTime?
  active       Boolean   @default(true)
  auto         Boolean   @default(false)
  revokedById  String?
  revokedAt    DateTime?
  revokeReason String?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([action, active, expiresAt])
}

model Giveaway {
  id             Int             @id @default(autoincrement())
  channelId      String
  messageId      String?
  hostId         String
  prize          String
  description    String?
  winners        Int
  endsAt         DateTime
  requiredRoleId String?
  minAccountDays Int             @default(0)
  ended          Boolean         @default(false)
  cancelled      Boolean         @default(false)
  winnerIds      String[]        @default([])
  createdAt      DateTime        @default(now())
  entries        GiveawayEntry[]

  @@index([ended, endsAt])
}

model GiveawayEntry {
  giveawayId Int
  userId     String
  createdAt  DateTime @default(now())
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@id([giveawayId, userId])
}

model Poll {
  id          Int        @id @default(autoincrement())
  channelId   String
  messageId   String?
  authorId    String
  question    String
  options     String[]
  multi       Boolean    @default(false)
  hideResults Boolean    @default(false)
  endsAt      DateTime?
  ended       Boolean    @default(false)
  createdAt   DateTime   @default(now())
  votes       PollVote[]

  @@index([ended, endsAt])
}

model PollVote {
  pollId    Int
  userId    String
  option    Int
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@id([pollId, userId, option])
}
