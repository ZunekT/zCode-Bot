# Adres strony (bez / na końcu) – też w Discord Developer Portal → OAuth2 → Redirects: <SITE_URL>/api/auth/callback
SITE_URL=http://localhost:3001
# Aplikacja Discord (ta sama co bot): ID i Client Secret z Developer Portal → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Sekret do podpisu sesji (openssl rand -hex 32)
SESSION_SECRET=
# Wewnętrzne API bota (ten sam sekret co INTERNAL_API_SECRET w bocie)
INTERNAL_API_URL=http://localhost:3100
INTERNAL_API_SECRET=
# Link do serwera Discord zxCode (przycisk „Zamów bota”)
DISCORD_INVITE_URL=https://discord.gg/zxcode
